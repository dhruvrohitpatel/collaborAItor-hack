# Data mode
USE_MOCK_DATA=true

# Firebase client app
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:replace-me"

# Firebase Admin server auth
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# App access allowlists
ALLOWED_INSTRUCTOR_EMAILS="instructor@example.edu"
ALLOWED_STUDENT_EMAILS="student1@example.edu,student2@example.edu"
DEMO_STUDENT_EMAILS="student1@example.edu,student2@example.edu"

# Test-only auth bypass for Playwright
ENABLE_TEST_AUTH=false

# Gemini / Vertex (optional; mock responses used when missing)
GEMINI_API_KEY=""
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-pro

# Google OAuth + Calendar (optional; required for real invites/Meet links)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/connect/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ElevenLabs (optional; required for meeting-summary audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
